# Copy to web/.env.local for local development. On Vercel, set the same names in
# Project → Settings → Environment Variables (scripts/setup_online.sh does it for you).

# Supabase: Dashboard → Project Settings → API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # the public "anon" / "publishable" key: safe in the browser, can do nothing on its own
SUPABASE_SERVICE_ROLE_KEY=            # the SECRET key: server-side only, never NEXT_PUBLIC_, never committed

# Shared password for the whole site (the browser asks for it; any username works).
# In production the site stays LOCKED until this is set.
RINKIQ_PASSWORD=

# Optional limits
# NEXT_PUBLIC_MAX_UPLOAD_MB=50   # keep ≤ the `videos` bucket limit (50 MB on Supabase's free plan)
# MAX_ACTIVE_JOBS=8       # uploads are refused while this many jobs are waiting or running
