# Copy to worker/.env (it is git-ignored) and fill in. Find both values in the Supabase dashboard:
# Project Settings → API (URL) and API Keys (the SECRET / service_role key).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional: cap how much of each video this worker analyses (seconds). Leave unset on your own laptop.
# RINKIQ_MAX_SECONDS=600
